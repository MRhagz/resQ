# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Hashing salt used when storing PhilSys IDs (server-only, never expose)
SYSTEM_HASH_SALT="generate-a-long-random-string"

# Cardano / Blockfrost
NETWORK=preview
BLOCKFROST_API_KEY="previewXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
WALLET_MNEMONIC="word1 word2 word3 ... word24"
SYSTEM_POLICY_ID=""

# KMS — local provider stores keys in keystore.enc.json encrypted with KMS_MASTER_KEY
KMS_PROVIDER=local
# 32 bytes hex (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_MASTER_KEY=""
